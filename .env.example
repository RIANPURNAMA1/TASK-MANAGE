# ─────────────────────────────────────────────────────────────────────
# Default di bawah ini cukup untuk menjalankan semuanya secara lokal dengan
# `npm run dev` — tanpa Docker, Redis, object storage, atau SMTP.
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=development

# MySQL 8 / MariaDB 10.4+. Lokal: MySQL bawaan XAMPP/Laragon (user root tanpa password).
# Database "nexustask" dibuat otomatis oleh migrasi; database lain di server tidak disentuh.
DATABASE_URL=mysql://root:@localhost:3306/nexustask

# Public URL of the web app (email links, OAuth redirects)
WEB_URL=http://localhost:5173

# ---------- API ----------
API_PORT=4000
# Production: generate with node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
COOKIE_SECRET=change-me-cookie-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
MIN_DESKTOP_VERSION=0.0.0

# ---------- Redis (opsional) ----------
# Kosong: job berjalan di dalam proses API dan real-time memakai memori (cukup untuk 1 server).
# Isi (mis. redis://localhost:6379) untuk produksi: antrean BullMQ + apps/worker + multi-instance.
REDIS_URL=

# ---------- Object storage ----------
# local: file disimpan di .data/uploads, diakses lewat URL bertanda tangan dari API.
# s3:    Cloudflare R2 / AWS S3 / MinIO dengan presigned URL.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---------- Email ----------
# SMTP_HOST kosong: email (verifikasi, undangan, reset password) dicetak di terminal API.
# true = akun dari link undangan wajib verifikasi email dulu. Kosong/false = langsung bisa login.
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Mendunia Workbase <no-reply@nexustask.local>"

# ---------- Google SSO (opsional; kosong = nonaktif) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# ---------- Jobs ----------
TZ_DEFAULT=Asia/Jakarta
DAILY_DIGEST_HOUR=8

# ── Workbase Agent (asisten AI) ──────────────────────────────────────────────
# API key bisa diisi di sini ATAU lewat Pengaturan → Asisten AI (disimpan terenkripsi
# di database dan menimpa key di .env). Penyedia tanpa key tidak ditawarkan.
AGENT_ENABLED=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Pencarian web (opsional): brave | tavily, lalu isi key yang sesuai.
AGENT_SEARCH_PROVIDER=
BRAVE_API_KEY=
TAVILY_API_KEY=
# 32 byte (64 hex / base64) untuk mengenkripsi token konektor. Buat: openssl rand -hex 32
AGENT_ENCRYPTION_KEY=
# Harga per model (USD per 1 juta token) supaya angka biaya akurat, contoh:
# AGENT_PRICING_JSON={"gpt-4o-mini":{"input":0.15,"output":0.6}}
AGENT_PRICING_JSON=
AGENT_MAX_RUN_COST_USD=0.5
AGENT_MAX_STEPS=12
