# ─────────────────────────────────────────────────────────────────────
# Default di bawah ini cukup untuk menjalankan semuanya secara lokal dengan
# `pnpm dev` — tanpa Docker, Redis, object storage, atau SMTP.
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=development

# MySQL 8 / MariaDB 10.4+. Lokal: MySQL bawaan XAMPP/Laragon (user root tanpa password).
# Database "nexustask" dibuat otomatis oleh migrasi; database lain di server tidak disentuh.
DATABASE_URL=mysql://root:@localhost:3306/nexustask

# Public URL of the web app (email links, OAuth redirects)
WEB_URL=http://localhost:5173

# ---------- API ----------
API_PORT=4000
# Production: generate with node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
COOKIE_SECRET=change-me-cookie-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
MIN_DESKTOP_VERSION=0.0.0

# ---------- Redis (opsional) ----------
# Kosong: job berjalan di dalam proses API dan real-time memakai memori (cukup untuk 1 server).
# Isi (mis. redis://localhost:6379) untuk produksi: antrean BullMQ + apps/worker + multi-instance.
REDIS_URL=

# ---------- Object storage ----------
# local: file disimpan di .data/uploads, diakses lewat URL bertanda tangan dari API.
# s3:    Cloudflare R2 / AWS S3 / MinIO dengan presigned URL.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---------- Email ----------
# SMTP_HOST kosong: email (verifikasi, undangan, reset password) dicetak di terminal API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="NexusTask <no-reply@nexustask.local>"

# ---------- Google SSO (opsional; kosong = nonaktif) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# ---------- Jobs ----------
TZ_DEFAULT=Asia/Jakarta
DAILY_DIGEST_HOUR=8
