{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mendunia Workbase",
  "version": "0.1.0",
  "identifier": "com.nexustask.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "npm run build:desktop -w @nexus/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mendunia Workbase",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: http://localhost:4000 https:",
        "media-src": "'self' blob: https:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:4000 ws://localhost:4000 https: wss:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: http://localhost:4000 https:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173 http://localhost:4000 ws://localhost:4000 https: wss:",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "Mendunia Workbase",
    "category": "Productivity",
    "shortDescription": "Task management, chat, dan pengumuman tim",
    "longDescription": "Mendunia Workbase: board kanban, chat tim, pengumuman, dan dashboard untuk semua divisi.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": { "minimumSystemVersion": "12.0" },
    "linux": { "deb": { "depends": [] } }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["taskapp"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGQzcxQ0JCMTY5QUU5Q0MKUldUTTZab1d1eHpIbjJsbDRxZGRTVTNzckdJaDhMUGVqT0xUcmlqeHdYdURLYkFRTUMrL3ZLK2EK",
      "endpoints": ["https://github.com/OWNER/REPO/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
