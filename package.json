{
  "name": "nexustask",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run db:deploy && turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "npm run migrate:dev -w @nexus/db",
    "db:deploy": "npm run migrate:deploy -w @nexus/db",
    "db:seed": "npm run seed -w @nexus/db",
    "db:studio": "npm run studio -w @nexus/db",
    "desktop:dev": "npm run desktop:dev -w @nexus/desktop",
    "desktop:build": "npm run desktop:build -w @nexus/desktop"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
